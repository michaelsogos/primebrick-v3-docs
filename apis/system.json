    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login with username and password",
        "x-badges": [
          {
            "name": "v1",
            "color": "#38bdf8",
            "position": "after"
          },
          {
            "name": "Latest",
            "color": "#22c55e",
            "position": "after"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
